# Copy to .env.local and fill in. Never commit .env.local.
NEXCONN_APP_KEY=your_app_key
NEXCONN_APP_SECRET=your_app_secret
NEXCONN_API_HOST=api.us-light-api.com
NEXCONN_API_HOST_BACKUP=api-b.us-light-api.com
NEXT_PUBLIC_NEXCONN_AREA=NA
# Optional: without these an in-memory store is used (one server only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
