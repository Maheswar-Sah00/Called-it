      "link": null,
      "locked": false,
      "text": "• open channel per room\n• custom messages CI:*\n• priority 2 for big cards\n• channel metadata\n• participant events\n• webhooks: pre_messaging\n   and message:send\n• mute + message delete",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• open channel per room\n• custom messages CI:*\n• priority 2 for big cards\n• channel metadata\n• participant events\n• webhooks: pre_messaging\n   and message:send\n• mute + message delete",
      "autoResize": true,
      "lineHeight": 1.25
    },
